---
import type { RichText } from "../../lib/blocks";
import { resolveBackgroundColor, resolveTextColor } from "../../lib/blocks";

interface Props {
  value: RichText[];
}

const { value } = Astro.props;
---

{
  value.map((part) => {
    const classes = [
      part.annotations?.bold && "rt-bold",
      part.annotations?.italic && "rt-italic",
      part.annotations?.underline && "rt-underline",
      part.annotations?.strike && "rt-strike",
      part.annotations?.code && "rt-code",
    ].filter(Boolean);
    const style = [
      resolveTextColor(part.textColor) && `color: ${resolveTextColor(part.textColor)}`,
      resolveBackgroundColor(part.backgroundColor) && `background: ${resolveBackgroundColor(part.backgroundColor)}`,
    ]
      .filter(Boolean)
      .join("; ");

    const content = part.annotations?.code ? (
      <code class:list={classes} style={style}>{part.text}</code>
    ) : (
      <span class:list={classes} style={style}>{part.text}</span>
    );

    return part.href ? (
      <a href={part.href} class="rt-link">{content}</a>
    ) : (
      content
    );
  })
}
