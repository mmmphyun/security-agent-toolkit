---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { withBase } from "../lib/site-path";
---

<BaseLayout title={`404 | ${SITE.title}`} mainClass="tistory-main">
  <div class="blog-archive">
    <header class="blog-topbar">
      <a href={withBase('/blog/')} class="blog-brand"><span>{SITE.brand.name}</span><strong>{SITE.brand.accent}</strong></a>
    </header>
    <section class="sidebar-panel">
      <div class="sidebar-panel__head">
        <h1>404</h1>
        <span>not found</span>
      </div>
      <p>The page you're looking for couldn't be found.</p>
      <div class="blog-pagination">
        <a href={withBase('/blog/')}>Back to blog</a>
        <span></span>
      </div>
    </section>
  </div>
</BaseLayout>