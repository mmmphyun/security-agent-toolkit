---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { type BlogSchema } from "../../content.config";
import PostLayout from "../../layouts/PostLayout.astro";
import createSlug from "../../lib/createSlug";
import type { Block } from "../../lib/blocks";
import { generateToc, type TocItem } from "../../lib/toc";

export async function getStaticPaths() {
  const postEntries = await getCollection("blog");
  return postEntries.map((entry) => ({
    params: { slug: entry.data.slug || createSlug(entry.data.title, entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const post: BlogSchema = entry.data;
const blocks = (post.blocks ?? []) as Block[];

let tocItems: TocItem[] = [];
let Content: any = null;

if (blocks.length > 0) {
  tocItems = generateToc(blocks);
} else {
  const rendered = await render(entry);
  Content = rendered.Content;
  tocItems = rendered.headings.map((h) => ({
    id: h.slug,
    text: h.text,
    level: (h.depth === 1 ? "h1" : h.depth === 2 ? "h2" : "h3") as "h1" | "h2" | "h3",
  }));
}
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  page={post.page}
  heroImage={post.heroImage}
  updatedDate={post.updatedDate}
  status={post.status}
  tags={post.tags}
  blocks={blocks}
  tocItems={tocItems}
>
  {Content && <Content />}
</PostLayout>
