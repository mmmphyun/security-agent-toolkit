---
import { getCollection } from "astro:content";
import BlogArchive from "../../components/blog/BlogArchive.astro";
import { getBlogCategory } from "../../lib/blog-category";

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagCounts = allPosts.reduce<Record<string, number>>((counts, post) => {
  for (const tag of post.data.tags ?? []) {
    counts[tag] = (counts[tag] ?? 0) + 1;
  }
  return counts;
}, {});

const categoryCounts = allPosts.reduce<Record<string, number>>((counts, post) => {
  const category = getBlogCategory(post);
  counts[category] = (counts[category] ?? 0) + 1;
  return counts;
}, {});

const page = { data: allPosts, url: {} };
---

<BlogArchive page={page} allPosts={allPosts} tagCounts={tagCounts} categoryCounts={categoryCounts} initialView="tags" />