---
import { getCollection } from "astro:content";
import BlogArchive from "../../components/blog/BlogArchive.astro";
import { getBlogCategory } from "../../lib/blog-category";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const tagCounts = posts.reduce<Record<string, number>>((counts, post) => {
    for (const tag of post.data.tags ?? []) {
      counts[tag] = (counts[tag] ?? 0) + 1;
    }
    return counts;
  }, {});

  const categoryCounts = posts.reduce<Record<string, number>>((counts, post) => {
    const category = getBlogCategory(post);
    counts[category] = (counts[category] ?? 0) + 1;
    return counts;
  }, {});

  return paginate(posts, {
    pageSize: Math.max(posts.length, 1),
    props: {
      allPosts: posts,
      tagCounts,
      categoryCounts,
    },
  });
}

const { page, allPosts = page.data, tagCounts = {}, categoryCounts = {} } = Astro.props;
---

<BlogArchive page={page} allPosts={allPosts} tagCounts={tagCounts} categoryCounts={categoryCounts} initialView="posts" />