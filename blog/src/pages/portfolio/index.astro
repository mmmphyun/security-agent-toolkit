<script>
  // 아키텍처 다이어그램 Lightbox 모달

  // 2. 아키텍처 다이어그램 Lightbox 모달
  const modal = document.getElementById('arch-lightbox') as HTMLDialogElement | null;
  const modalImg = document.getElementById('arch-modal-img') as HTMLImageElement | null;
  const modalTitle = document.getElementById('arch-modal-title');
  const modalClose = document.getElementById('arch-modal-close');

  document.querySelectorAll('.zoom-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modal || !modalImg) return;
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('dark');
      const src = isDark ? btn.getAttribute('data-dark') : btn.getAttribute('data-light');
      if (src) modalImg.src = src;
      if (modalTitle) modalTitle.textContent = btn.getAttribute('data-title') || '';
      modal.showModal();
    });
  });

  modalClose?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>

