---
import { type BlogSchema } from "../content.config";
import BaseLayout from "./BaseLayout.astro";
import { SITE } from "../config";
import { withBase } from "../lib/site-path";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";
import type { Block } from "../lib/blocks";
import { toEmbeddableImageUrl } from "../lib/image-url";
import type { TocItem } from "../lib/toc";
import "../styles/blocks.css";

export interface Props extends BlogSchema {
  blocks?: Block[];
  tocItems?: TocItem[];
}

const { title, description, pubDate, updatedDate, heroImage, status = [], tags = [], page, blocks = [], tocItems = [] } = Astro.props;
const pageIcon = page?.icon;
const pageCover = page?.cover;
const formatDate = (date: Date) => new Intl.DateTimeFormat(SITE.locale, { dateStyle: "medium" }).format(date);
const numberedListStart = (items: Block[], index: number) => {
  if (items[index]?.type !== "numbered_list") return 1;
  let start = 1;
  for (let cursor = index - 1; cursor >= 0 && items[cursor]?.type === "numbered_list"; cursor -= 1) start += 1;
  return start;
};
---

<BaseLayout
  title={`${title} | ${SITE.title}`}
  description={description}
  image={heroImage}
  ogType="article"
  includeSidebar={false}
  showHeader={false}
  showFooter={false}
  mainClass="notion-main"
>
  <div class="block-page">
    <article class="block-article" data-block-article>
      <header class:list={["block-hero", pageCover && "block-hero--has-cover", pageCover && `block-hero--${pageCover.type}`, pageIcon && "block-hero--has-icon"]}>
        <nav class="notion-breadcrumb" aria-label="Breadcrumb">
          <a href={withBase('/blog/')}>Blog</a>
          <span>/</span>
          <span>{title}</span>
        </nav>
        {pageCover && (
          <div
            class:list={["block-cover", `block-cover--${pageCover.type}`]}
            style={pageCover.type === "color" ? `--block-cover-color: ${pageCover.value}` : undefined}
            aria-hidden="true"
          >
            {pageCover.type === "image" && (
              <img
                src={toEmbeddableImageUrl(pageCover.value)}
                alt=""
                style={`object-position: center ${pageCover.position ?? 50}%`}
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        )}
        <div class="block-hero__content">
          {pageIcon && <div class="block-page-icon" aria-hidden="true">{pageIcon}</div>}
          <h1>{title}</h1>
          <p>{description}</p>
          <dl class="block-properties">
            {pubDate && (
              <div>
                <dt>Date</dt>
                <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
              </div>
            )}
            {updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></dd>
              </div>
            )}
            {status.length > 0 && (
              <div>
                <dt>Status</dt>
                <dd class="block-property-status">
                  {status.map((item) => <span class="block-badge">{item}</span>)}
                </dd>
              </div>
            )}
            {tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd class="block-property-tags">
                  {tags.map((tag) => (
                    <a href={withBase(`/blog/tag/${encodeURIComponent(tag)}/`)} class="block-tag" data-astro-reload>
                      {tag}
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </header>

      <div class="block-workspace">
        <div class="block-content-column">
          <div class="block-shell">
            <div class="block-document prose max-w-none text-base md:text-lg leading-relaxed space-y-6">
              {blocks.length > 0 ? blocks.map((block, index) => <BlockRenderer block={block} tocItems={tocItems} numberedListStart={numberedListStart(blocks, index)} />) : <slot />}
            </div>
          </div>
        </div>

        {tocItems.length > 0 && (
          <aside class="block-outline block-bento__card sticky top-24" aria-label="Outline">
            <span class="block-bento__index">목차</span>
            <nav class="space-y-1 mt-3">
              {tocItems.map((item) => (
                <a href={`#${item.id}`} class={`block-toc__link block-toc__link--${item.level} block py-1 text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors`} data-toc-link={item.id}>
                  {item.text}
                </a>
              ))}
            </nav>
          </aside>
        )}
      </div>
    </article>
  </div>

  <style is:global>
    /* 벨로그/미디엄 스타일의 시원한 가독성 타이포그래피 (라이트/다크 양방향 변수 지원) */
    .block-document {
      line-height: 1.9;
      color: var(--color-ink-soft);
    }
    .block-document p {
      margin-bottom: 1.75rem;
      word-break: keep-all;
      color: var(--color-ink-soft);
    }
    .block-document h2 {
      margin-top: 3.5rem !important;
      margin-bottom: 1.5rem !important;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--color-line) !important;
      font-size: 1.75rem !important;
      font-weight: 700 !important;
      color: var(--color-ink) !important;
    }
    .block-document h3 {
      margin-top: 2.5rem !important;
      margin-bottom: 1rem !important;
      font-size: 1.35rem !important;
      font-weight: 600 !important;
      color: var(--color-ink) !important;
    }
    .block-document h4 {
      color: var(--color-ink) !important;
    }
    .block-document hr {
      margin-top: 3.5rem !important;
      margin-bottom: 3.5rem !important;
      border-color: var(--color-line) !important;
    }
    .block-document pre {
      margin-top: 1.5rem !important;
      margin-bottom: 2rem !important;
      padding: 1.25rem !important;
      border-radius: 0.75rem !important;
      border: 1px solid var(--color-line) !important;
      background-color: var(--color-paper-soft) !important;
    }
    /* Shiki 듀얼 테마 다크 모드 토큰 오버라이드 */
    html[data-theme="dark"] .block-document pre code span {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
    .block-document table {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      border: 1px solid var(--color-line);
      font-size: 0.92rem;
    }
    .block-document th,
    .block-document td {
      border: 1px solid var(--color-line);
      padding: 0.65rem 0.95rem;
    }
    .block-document th {
      background-color: var(--color-paper-soft);
      color: var(--color-ink);
      font-weight: 600;
    }
    .block-document td {
      color: var(--color-ink-soft);
    }
    .block-document code:not(pre code) {
      padding: 0.2rem 0.45rem;
      border-radius: 0.375rem;
      background-color: var(--color-paper-soft);
      border: 1px solid var(--color-line);
      color: var(--color-blue);
      font-size: 0.9em;
    }
    .block-document blockquote {
      border-left: 3px solid var(--color-blue);
      color: var(--color-muted);
      padding-left: 1rem;
    }
    .block-document ul,
    .block-document ol {
      color: var(--color-ink-soft);
    }
    .block-document strong {
      color: var(--color-ink);
    }
    .block-document a {
      color: var(--color-blue);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .mermaid-container {
      margin: 2.5rem 0;
      padding: 1.5rem;
      border-radius: 0.75rem;
      background-color: var(--color-paper-soft);
      border: 1px solid var(--color-line);
      display: flex;
      justify-content: center;
      overflow-x: auto;
    }
    .mermaid-container svg {
      max-width: 100%;
      height: auto;
    }
  </style>

  <script>
    import mermaid from "mermaid";

    function getMermaidConfig(isDark: boolean) {
      return {
        startOnLoad: false,
        theme: (isDark ? "dark" : "default") as any,
        securityLevel: "loose" as any,
        themeVariables: isDark ? {
          darkMode: true,
          background: "#18181b",
          primaryColor: "#27272a",
          primaryTextColor: "#f4f4f5",
          primaryBorderColor: "#52525b",
          lineColor: "#79bdf0",
          secondaryColor: "#1e293b",
          tertiaryColor: "#0f172a",
          fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif",
        } : {
          darkMode: false,
          background: "#ffffff",
          primaryColor: "#f4f6f8",
          primaryTextColor: "#111827",
          primaryBorderColor: "#cbd5e1",
          lineColor: "#0284c7",
          secondaryColor: "#e0f2fe",
          tertiaryColor: "#f8fafc",
          fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif",
        },
      };
    }

    let mermaidIndex = 0;

    async function renderAllMermaid(isDark: boolean) {
      mermaid.initialize(getMermaidConfig(isDark));

      // 1. 이미 렌더링되어 data-raw-code를 보유한 컨테이너 실시간 리렌더링
      const existingContainers = Array.from(document.querySelectorAll<HTMLElement>(".mermaid-container[data-raw-code]"));
      for (const container of existingContainers) {
        const rawCode = container.dataset.rawCode;
        if (!rawCode) continue;
        const containerId = `mermaid-svg-${Date.now()}-${mermaidIndex++}`;
        try {
          const { svg } = await mermaid.render(containerId, rawCode);
          container.innerHTML = svg;
        } catch (err) {
          console.error("Mermaid 실시간 테마 리렌더링 실패:", err);
        }
      }

      // 2. 최초 실행 시 pre 블록을 찾아 컨테이너로 교체 및 raw-code 보존
      const codeBlocks = Array.from(document.querySelectorAll(".block-document pre"));
      for (const pre of codeBlocks) {
        const codeElement = pre.querySelector("code");
        const className = (pre.className || "") + " " + (codeElement?.className || "");
        const text = pre.textContent || "";

        if (className.includes("mermaid") || text.trim().startsWith("sequenceDiagram") || text.trim().startsWith("flowchart") || text.trim().startsWith("graph") || text.trim().startsWith("stateDiagram")) {
          const rawCode = text.trim();
          const containerId = `mermaid-svg-${Date.now()}-${mermaidIndex++}`;
          
          try {
            const { svg } = await mermaid.render(containerId, rawCode);
            const container = document.createElement("div");
            container.className = "mermaid-container not-prose";
            container.dataset.rawCode = rawCode;
            container.innerHTML = svg;
            pre.replaceWith(container);
          } catch (err) {
            console.error("Mermaid 초기 렌더링 실패:", err);
          }
        }
      }
    }

    function initTOC() {
      const headings = Array.from(document.querySelectorAll(".block-document h1[id], .block-document h2[id], .block-document h3[id], [data-heading-block='true']"));
      const tocLinks = new Map(
        Array.from(document.querySelectorAll("[data-toc-link]")).map((link) => [
          link.getAttribute("data-toc-link"),
          link,
        ])
      );

      if ("IntersectionObserver" in window && headings.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

            if (!visible) return;

            tocLinks.forEach((link) => link.classList.remove("text-primary", "font-bold"));
            const activeLink = tocLinks.get(visible.target.id);
            if (activeLink) {
              activeLink.classList.add("text-primary", "font-bold");
            }
          },
          { rootMargin: "-10% 0px -70% 0px", threshold: 0.05 }
        );

        headings.forEach((heading) => observer.observe(heading));
      }
    }

    let themeObserver: MutationObserver | null = null;

    function setupThemeObserver() {
      if (themeObserver) {
        themeObserver.disconnect();
      }

      let lastTheme = document.documentElement.getAttribute("data-theme") || "light";

      themeObserver = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.type === "attributes" && m.attributeName === "data-theme") {
            const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
            if (currentTheme !== lastTheme) {
              lastTheme = currentTheme;
              renderAllMermaid(currentTheme === "dark");
            }
          }
        }
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    function init() {
      const isDark = document.documentElement.getAttribute("data-theme") === "dark";
      renderAllMermaid(isDark);
      initTOC();
      setupThemeObserver();
    }

    document.addEventListener("astro:page-load", init);
    init();
  </script>
</BaseLayout>
