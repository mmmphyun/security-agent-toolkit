---
import { type BlogSchema } from "../content.config";
import BaseLayout from "./BaseLayout.astro";
import { SITE } from "../config";
import { withBase } from "../lib/site-path";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";
import type { Block } from "../lib/blocks";
import { toEmbeddableImageUrl } from "../lib/image-url";
import type { TocItem } from "../lib/toc";
import "../styles/blocks.css";

export interface Props extends BlogSchema {
  blocks?: Block[];
  tocItems?: TocItem[];
}

const { title, description, pubDate, updatedDate, heroImage, status = [], tags = [], page, blocks = [], tocItems = [] } = Astro.props;
const pageIcon = page?.icon;
const pageCover = page?.cover;
const formatDate = (date: Date) => new Intl.DateTimeFormat(SITE.locale, { dateStyle: "medium" }).format(date);
const numberedListStart = (items: Block[], index: number) => {
  if (items[index]?.type !== "numbered_list") return 1;
  let start = 1;
  for (let cursor = index - 1; cursor >= 0 && items[cursor]?.type === "numbered_list"; cursor -= 1) start += 1;
  return start;
};
---

<BaseLayout
  title={`${title} | ${SITE.title}`}
  description={description}
  image={heroImage}
  ogType="article"
  includeSidebar={false}
  showHeader={false}
  showFooter={false}
  mainClass="notion-main"
>
  <div class="block-page">
    <article class="block-article" data-block-article>
      <header class:list={["block-hero", pageCover && "block-hero--has-cover", pageCover && `block-hero--${pageCover.type}`, pageIcon && "block-hero--has-icon"]}>
        <nav class="notion-breadcrumb" aria-label="Breadcrumb">
          <a href={withBase('/blog/')}>Blog</a>
          <span>/</span>
          <span>{title}</span>
        </nav>
        {pageCover && (
          <div
            class:list={["block-cover", `block-cover--${pageCover.type}`]}
            style={pageCover.type === "color" ? `--block-cover-color: ${pageCover.value}` : undefined}
            aria-hidden="true"
          >
            {pageCover.type === "image" && (
              <img
                src={toEmbeddableImageUrl(pageCover.value)}
                alt=""
                style={`object-position: center ${pageCover.position ?? 50}%`}
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        )}
        <div class="block-hero__content">
          {pageIcon && <div class="block-page-icon" aria-hidden="true">{pageIcon}</div>}
          <h1>{title}</h1>
          <p>{description}</p>
          <dl class="block-properties">
            {pubDate && (
              <div>
                <dt>Date</dt>
                <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
              </div>
            )}
            {updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></dd>
              </div>
            )}
            {status.length > 0 && (
              <div>
                <dt>Status</dt>
                <dd class="block-property-status">
                  {status.map((item) => <span class="block-badge">{item}</span>)}
                </dd>
              </div>
            )}
            {tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd class="block-property-tags">
                  {tags.map((tag) => (
                    <a href={withBase(`/blog/tag/${encodeURIComponent(tag)}/`)} class="block-tag" data-astro-reload>
                      {tag}
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </header>

      <div class="block-workspace">
        <div class="block-content-column">
          <div class="block-shell">
            <div class="block-document prose prose-invert max-w-none text-base md:text-lg leading-relaxed space-y-6">
              {blocks.length > 0 ? blocks.map((block, index) => <BlockRenderer block={block} tocItems={tocItems} numberedListStart={numberedListStart(blocks, index)} />) : <slot />}
            </div>
          </div>
        </div>

        {tocItems.length > 0 && (
          <aside class="block-outline block-bento__card sticky top-24" aria-label="Outline">
            <span class="block-bento__index">목차</span>
            <nav class="space-y-1 mt-3">
              {tocItems.map((item) => (
                <a href={`#${item.id}`} class={`block-toc__link block-toc__link--${item.level} block py-1 text-sm text-zinc-400 hover:text-zinc-100 transition-colors`} data-toc-link={item.id}>
                  {item.text}
                </a>
              ))}
            </nav>
          </aside>
        )}
      </div>
    </article>
  </div>

  <style is:global>
    /* 벨로그/미디엄 스타일의 시원한 가독성 타이포그래피 */
    .block-document {
      line-height: 1.9;
      color: #d4d4d8;
    }
    .block-document p {
      margin-bottom: 1.75rem;
      word-break: keep-all;
    }
    .block-document h2 {
      margin-top: 3.5rem !important;
      margin-bottom: 1.5rem !important;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 1.75rem !important;
      font-weight: 700 !important;
      color: #fafafa !important;
    }
    .block-document h3 {
      margin-top: 2.5rem !important;
      margin-bottom: 1rem !important;
      font-size: 1.35rem !important;
      font-weight: 600 !important;
      color: #f4f4f5 !important;
    }
    .block-document hr {
      margin-top: 3.5rem !important;
      margin-bottom: 3.5rem !important;
      border-color: rgba(255, 255, 255, 0.12) !important;
    }
    .block-document pre {
      margin-top: 1.5rem !important;
      margin-bottom: 2rem !important;
      padding: 1.25rem !important;
      border-radius: 0.75rem !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .block-document code:not(pre code) {
      padding: 0.2rem 0.4rem;
      border-radius: 0.375rem;
      background-color: rgba(255, 255, 255, 0.08);
      color: #38bdf8;
      font-size: 0.9em;
    }
    .mermaid-container {
      margin: 2.5rem 0;
      padding: 1.5rem;
      border-radius: 0.75rem;
      background-color: rgba(24, 24, 27, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      justify-content: center;
      overflow-x: auto;
    }
    .mermaid-container svg {
      max-width: 100%;
      height: auto;
    }
  </style>

  <script>
    import mermaid from "mermaid";

    async function initMermaidAndTOC() {
      mermaid.initialize({
        startOnLoad: false,
        theme: "dark",
        securityLevel: "loose",
        themeVariables: {
          darkMode: true,
          background: "#18181b",
          primaryColor: "#27272a",
          primaryTextColor: "#f4f4f5",
          primaryBorderColor: "#52525b",
          lineColor: "#38bdf8",
          secondaryColor: "#1e293b",
          tertiaryColor: "#0f172a",
          fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif",
        },
      });

      // 마크다운 내 mermaid 블록 탐색 (pre 또는 code)
      const codeBlocks = Array.from(document.querySelectorAll(".block-document pre"));
      let index = 0;

      for (const pre of codeBlocks) {
        const codeElement = pre.querySelector("code");
        const className = (pre.className || "") + " " + (codeElement?.className || "");
        const text = pre.textContent || "";

        // mermaid 코드 블록 판별
        if (className.includes("mermaid") || text.trim().startsWith("sequenceDiagram") || text.trim().startsWith("flowchart") || text.trim().startsWith("graph")) {
          const rawCode = text.trim();
          const containerId = `mermaid-svg-${Date.now()}-${index++}`;
          
          try {
            const { svg } = await mermaid.render(containerId, rawCode);
            const container = document.createElement("div");
            container.className = "mermaid-container not-prose";
            container.innerHTML = svg;
            pre.replaceWith(container);
          } catch (err) {
            console.error("Mermaid 렌더링 실패:", err);
          }
        }
      }

      // TOC IntersectionObserver 감지
      const headings = Array.from(document.querySelectorAll(".block-document h1[id], .block-document h2[id], .block-document h3[id], [data-heading-block='true']"));
      const tocLinks = new Map(
        Array.from(document.querySelectorAll("[data-toc-link]")).map((link) => [
          link.getAttribute("data-toc-link"),
          link,
        ])
      );

      if ("IntersectionObserver" in window && headings.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

            if (!visible) return;

            tocLinks.forEach((link) => link.classList.remove("text-primary", "font-bold"));
            const activeLink = tocLinks.get(visible.target.id);
            if (activeLink) {
              activeLink.classList.add("text-primary", "font-bold");
            }
          },
          { rootMargin: "-10% 0px -70% 0px", threshold: 0.05 }
        );

        headings.forEach((heading) => observer.observe(heading));
      }
    }

    document.addEventListener("astro:page-load", initMermaidAndTOC);
    initMermaidAndTOC();
  </script>
</BaseLayout>
